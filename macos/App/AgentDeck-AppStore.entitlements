<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Mac App Store channel (App Sandbox, required by App Review 2.4.5(i)).
     network.client: the agent server + voice. audio-input: mic.
     files.user-selected.read-only: NSOpenPanel attach. No temporary
     exceptions, network.server, apple-events or files.all. Contract C2. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
</dict>
</plist>
