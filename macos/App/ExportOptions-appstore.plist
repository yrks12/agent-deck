<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- xcodebuild -exportArchive for the Mac App Store channel. Produces a .pkg
     signed with the Mac Installer Distribution identity. Used by
     Scripts/build-release.sh only when an "Apple Distribution" identity,
     DECK_TEAM_ID and DECK_MAS_PROFILE (the provisioning profile name) exist;
     both are filled in at run time, never committed. -->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>signingStyle</key>
	<string>manual</string>
	<key>signingCertificate</key>
	<string>Apple Distribution</string>
	<key>installerSigningCertificate</key>
	<string>3rd Party Mac Developer Installer</string>
	<key>teamID</key>
	<string></string>
	<key>provisioningProfiles</key>
	<dict>
	</dict>
	<key>destination</key>
	<string>export</string>
	<key>uploadSymbols</key>
	<true/>
</dict>
</plist>
